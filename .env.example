# 抖音 cookie（主项目接口认证）
DY_COOKIES=''
# 直播弹幕 cookie
DY_LIVE_COOKIES=''
# 登录凭证（扫码登录后由 login_grab_ticket 自动写入，用于私信签名）
DY_TICKET=''
DY_TS_SIGN=''
DY_CLIENT_CERT=''
DY_PRIVATE_KEY=''
# 写接口使用的浏览器设备特征内层 blob；留空时使用包内 dtrait_profile.json
DY_DTRAIT_BLOB=''
# 可选：换设备时指定自己采集的 dtrait 档案 JSON 路径
DY_DTRAIT_PROFILE=''

# ── 直播间事件上报（可选）─────────────────────────────
# 把聊天/礼物/进场/关注写成结构化事件，投递到 Redis Stream，供 ai-games 消费
LIVE_EVENT=on
LIVE_EVENT_STREAM=ai-games:stream:live
LIVE_EVENT_MAXLEN=5000
LIVE_REDIS_HOST=127.0.0.1
LIVE_REDIS_PORT=6379
LIVE_REDIS_PASSWORD=
LIVE_REDIS_DB=0
