# 抖音 cookie（主项目接口认证）
DY_COOKIES=''
# 直播弹幕 cookie
DY_LIVE_COOKIES=''
# 登录凭证（扫码登录后由 login_grab_ticket 自动写入，用于私信签名）
DY_TICKET=''
DY_TS_SIGN=''
DY_CLIENT_CERT=''
DY_PRIVATE_KEY=''
# 写接口使用的浏览器设备特征内层 blob；留空时使用包内 dtrait_profile.json
DY_DTRAIT_BLOB=''
# 可选：换设备时指定自己采集的 dtrait 档案 JSON 路径
DY_DTRAIT_PROFILE=''

# ── 直播间事件上报（可选）─────────────────────────────
# 把聊天/礼物/进场/关注写成结构化事件，投递到 Redis Stream，供 ai-games 消费
LIVE_EVENT=on
LIVE_EVENT_STREAM=ai-games:stream:live
LIVE_EVENT_MAXLEN=5000
LIVE_REDIS_HOST=127.0.0.1
LIVE_REDIS_PORT=6379
LIVE_REDIS_PASSWORD=
LIVE_REDIS_DB=0

# ── MCP 服务（远程 MCP + OAuth 2.0 登录，经 Cloudflare 隧道对外）──────────
# 安装：pip install -r requirements-mcp.txt   启动：python -m mcp_server
MCP_HOST=127.0.0.1
MCP_PORT=8765
# 公网入口，必须与隧道 ingress 的 hostname 一致（OAuth issuer / resource 都取它）
MCP_PUBLIC_URL=https://douyin.vbvcv.xyz
MCP_USERNAME=douyin
MCP_PASSWORD=change-me
MCP_ACCESS_TOKEN_TTL=3600
MCP_REFRESH_TOKEN_TTL=2592000
# on=注册写工具（评论/私信/发布/下载），off=只读
MCP_ENABLE_WRITE=on
MCP_WRITE_RATE_LIMIT=300
MCP_WRITE_RATE_WINDOW=600
MCP_LOGIN_MAX_FAILS=5
MCP_LOGIN_WINDOW=600
MCP_LOGIN_LOCK_SECONDS=300
# 私信实时接收（WebSocket 推送）：开机自动连接 + 内存缓冲条数
MCP_IM_AUTOSTART=on
MCP_IM_BUFFER=5000
# 不做动态注册（DCR）的客户端才需要
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
MCP_CLIENT_REDIRECT_URIS=
# 留空则自动生成到 datas/mcp/secret.key（0600）
MCP_SECRET_KEY=
